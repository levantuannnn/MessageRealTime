{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "Controllers/**/*.ts",
    "Model/**/*.ts",
    "db/**/*.ts",
    "Routes/**/*.ts"
  ]
}
